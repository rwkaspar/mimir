# Orientation (vertical) is handled by rotating the web UI in the browser via
# CSS, NOT by rotating the display here. The panel stays in its native
# landscape mode so touch input is 1:1 and the browser can hit-test the
# rotated layout correctly — our USB touch panel ignores compositor/udev
# rotation. (See viewer/index.html .rotate-left.)

# Seamless boot: paint the mimir logo on black as the compositor background so
# there is no blank screen between the Plymouth splash and the browser's first
# paint. The logo is the orientation-correct one the boot splash installed.
# Harmless if swaybg or the image is absent.
SPLASH_IMG=/usr/share/plymouth/themes/photoframe/logo.png
if command -v swaybg >/dev/null 2>&1 && [ -f "$SPLASH_IMG" ]; then
    # Retry: at cold boot the output can be a moment behind labwc, so a single
    # swaybg call may find no output and exit. Keep trying until it sticks
    # (a successful swaybg never returns). Give up after a few seconds.
    # Retry briefly in case the output is a moment behind labwc at cold boot
    # (a successful swaybg never returns).
    ( for i in 1 2 3 4 5; do
          swaybg -m center -c 000000 -i "$SPLASH_IMG" && break
          sleep 1
      done ) &
fi

# Kiosk browser: cog (WPE WebKit), NOT Chromium — Chromium forces a GLES 3.0
# context the Pi Zero 2 W's VideoCore IV (GLES 2.0) can't provide, so it never
# presents a frame. Fullscreen via the Wayland platform.
#
# Hardware H.264 video decode (critical on 512 MB): WPE only uses the Pi's v4l2
# decoder (/dev/video10) when all of these hold — GL compositing is on with
# GST_GL_API=gles2, v4l2h264dec is ranked above the software avdec_h264, and the
# device is reachable. The WebProcess sandbox otherwise hides /dev/video10, so
# it's disabled here (acceptable: a kiosk shows only its own local content).
# Without this, software-decoding a 1080p+ slideshow video pegs all cores and
# hard-freezes the board. The black backing-store tile that GL compositing can
# leave is cleared by the repaint nudge in index.html/wizard.html — NOT by
# WEBKIT_DISABLE_COMPOSITING_MODE, which would force slow software video decode.
GST_GL_API=gles2 GST_PLUGIN_FEATURE_RANK=v4l2h264dec:512 \
    WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1 COG_PLATFORM_WL_VIEW_FULLSCREEN=1 \
    cog --platform=wl --webprocess-failure=restart http://localhost:8080/ &
