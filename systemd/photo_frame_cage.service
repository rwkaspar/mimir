[Unit]
Description=Digital Photo Frame Viewer (labwc + cog/WPE)
After=network.target photo_frame_server.service
Wants=photo_frame_server.service
Conflicts=display-manager.service

[Service]
Type=simple
User=robert
SupplementaryGroups=video input render
TTYPath=/dev/tty1
Environment="XDG_RUNTIME_DIR=/tmp/frame-runtime"
Environment="XDG_CONFIG_HOME=/home/robert/digital_photo_frame"
Environment="XCURSOR_PATH=/home/robert/digital_photo_frame/labwc/icons"
Environment="XCURSOR_THEME=empty"
Environment="XCURSOR_SIZE=1"
ExecStartPre=/bin/mkdir -p /tmp/frame-runtime
ExecStartPre=/bin/chmod 700 /tmp/frame-runtime
ExecStartPre=/bin/sleep 5
# Quit Plymouth at the last moment (its spinner animates until now). Plain quit
# (no --retain-splash): the retained framebuffer made labwc's swapchain setup
# fail/retry for seconds; without it labwc comes up faster and swaybg paints
# sooner. The '+' runs it as root (ExecStartPre otherwise runs as User=).
ExecStartPre=+-/usr/bin/plymouth quit
ExecStart=/usr/bin/labwc -s /bin/true
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
