# Reference copy — setup_pi.sh writes the real unit with the frame's own user
# and paths. Enabled INSTEAD of photo_frame_slideshow when `variant: eink`.
[Unit]
Description=mimir e-ink cycle (draw one image, then sleep)
After=network.target photo_frame_server.service
Wants=photo_frame_server.service

[Service]
Type=simple
User=frame
SupplementaryGroups=spi gpio i2c
WorkingDirectory=/home/frame/digital_photo_frame
Environment="PYTHONPATH=/opt/mimir-eink"
ExecStart=/usr/bin/python3 -m frame.eink_cycle /home/frame/digital_photo_frame/config_frame.yaml
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
